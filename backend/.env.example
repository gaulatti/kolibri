# Application
PORT=3000
CORS_ALLOWED_ORIGINS=https://kolibri.dev,http://localhost:5173,http://localhost:5188

# Optional provider override. Unset uses local providers in development and
# production providers when NODE_ENV=production.
# KOLIBRI_RUNTIME_MODE=production

# Amazon Cognito (identifiers only; never place JWTs or provider credentials here)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_3a0pBzmTH
COGNITO_APP_CLIENT_ID=3cvllf2lfiqfp945a79a1kq0st

# Optional namespace for the Design System runtime secret and the S3 key prefix
# (default: kolibri). It no longer names the system secret.
# KOLIBRI_STACK_NAME=kolibri

# Production reads its settings from Kolibri's entry of the shared Secrets
# Manager envelope: SECRET_ARN names the envelope and UNIQUE_KEY the entry
# (PostgreSQL, S3 storage, npm registry, Cognito and CORS; see
# infrastructure/README.md). Set them only for a production-mode run.
# SECRET_ARN=
# UNIQUE_KEY=

# Production PostgreSQL and S3 settings are resolved from that entry.
# Development uses Dockerized PostgreSQL for application records, SQLite only
# as the local Secrets Manager substitute, and local filesystem artifact storage.
