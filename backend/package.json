{
  "name": "backend",
  "version": "0.0.2",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:coverage": "jest --coverage --coverageReporters=json --coverageReporters=text-summary --coverageProvider=v8 --testTimeout=30000 --collectCoverageFrom='**/*.ts' --coverageThreshold='{}'",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/persistence/typeorm.datasource.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/persistence/typeorm.datasource.ts",
    "migration:run:prod": "typeorm migration:run -d dist/persistence/typeorm.datasource.js",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/persistence/typeorm.datasource.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/persistence/typeorm.datasource.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/client-secrets-manager": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.3",
    "adm-zip": "^0.6.0",
    "aws-jwt-verify": "^5.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "semver": "^7.8.5",
    "sql.js": "^1.14.1",
    "typeorm": "^1.1.0",
    "validate-npm-package-name": "^7.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "^7.7.1",
    "@types/sql.js": "^1.4.11",
    "@types/supertest": "^6.0.2",
    "@types/validate-npm-package-name": "^4.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/*.constants.ts",
      "!**/*.types.ts",
      "!**/*.entity.ts",
      "!**/dto/*.dto.ts",
      "!**/index.ts",
      "!main.ts",
      "!persistence/date-column-type.ts",
      "!persistence/persistence.entities.ts",
      "!persistence/typeorm.datasource.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "functions": 100,
        "lines": 100,
        "branches": 90
      }
    },
    "testEnvironment": "node"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
