# Existing public Route 53 hosted zone and the frontend DNS label.
KOLIBRI_DOMAIN=example.com
KOLIBRI_HOSTED_ZONE_ID=Z1111111111111
KOLIBRI_SUBDOMAIN=kolibri

# Loaded locally by the CDK application for Cognito's Google provider. These
# values are never stored in the Kolibri system secret.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
