# Application
PORT=3000
CORS_ALLOWED_ORIGINS=https://kolibri.dev,http://localhost:5173,http://localhost:5188

# Optional provider override. Unset uses local providers in development and
# production providers when NODE_ENV=production.
# KOLIBRI_RUNTIME_MODE=production

# Amazon Cognito (identifiers only; never place JWTs or provider credentials here)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_3a0pBzmTH
COGNITO_APP_CLIENT_ID=3cvllf2lfiqfp945a79a1kq0st

# Production AWS namespace (development secrets and artifacts stay local)
# KOLIBRI_STACK_NAME comes from the CDK output and derives the system secret,
# shared Design System runtime secret, and S3 key namespace.
KOLIBRI_STACK_NAME=replace-with-KolibriStackName-output

# Production PostgreSQL and S3 settings are resolved from the system secret.
# Development uses Dockerized PostgreSQL for application records, SQLite only
# as the local Secrets Manager substitute, and local filesystem artifact storage.
