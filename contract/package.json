{
  "name": "@kolibri/neutral-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node src/build.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:coverage": "c8 --all --include='src/**/*.mjs' --include='releases/**/*.mjs' --reporter=json --reporter=json-summary --reporter=text --check-coverage --lines=100 --branches=100 node --test --test-concurrency=1 test/*.test.mjs",
    "validate": "node releases/0.1.0/bin/validate.mjs releases/0.1.0",
    "verify:determinism": "node src/verify-determinism.mjs"
  },
  "devDependencies": {
    "c8": "12.0.0"
  }
}
